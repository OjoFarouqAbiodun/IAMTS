# ===========================================================================
# IAMTS Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in real values:
#   copy .env.example .env
#
# NEVER commit .env to version control. The .gitignore excludes it, but
# if sharing the project folder, always use a fresh .env.example → .env copy.
#
# PRODUCTION CHECKLIST:
#   NODE_ENV=production        — enables secure cookies, production warnings
#   COOKIE_SECURE=true         — requires HTTPS; cookie sent only over TLS
#   SESSION_SECRET=<random>    — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   DB_USER=<non-root user>    — create a dedicated MySQL user with minimal privileges
#   APP_BASE_URL=https://...   — must be HTTPS in production
# ===========================================================================

# --- Session ---
SESSION_SECRET=change_me_to_a_long_random_string

# --- Cookies ---
# Set to "true" in production (requires HTTPS). In development, leave "false".
COOKIE_SECURE=false

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iamts

# --- Application ---
# Production: https://your-domain.com
APP_BASE_URL=http://localhost:3000

# --- Environment ---
# "production" enables secure cookies and the in-memory session store warning.
# "development" (default) disables secure cookies for local HTTP.
NODE_ENV=development

# --- Audit logging ---
# Set to "false" to disable audit writes entirely (default: enabled).
AUDIT_LOG_ENABLED=true
# Audit retention window in days. Defaults to 180; bounded to [1, 3650].
AUDIT_RETENTION_DAYS=180

# --- Admin Bootstrap (used by database/init.js) ---
# If omitted, init.js prompts interactively for these values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DEPARTMENT=ICT
